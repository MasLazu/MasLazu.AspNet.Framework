<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Properties -->
    <PackageId>MasLazu.AspNet.Framework.EfCore.Postgresql</PackageId>
    <Version>1.0.0</Version>
    <Authors>MasLazu</Authors>
    <Company>MasLazu</Company>
    <Description>PostgreSQL provider for MasLazu.AspNet.Framework.EfCore - Adds PostgreSQL support to the EF Core infrastructure layer.</Description>
    <PackageTags>dotnet;aspnetcore;efcore;postgresql;npgsql;database;clean-architecture</PackageTags>
    <RepositoryUrl>https://github.com/MasLazu/MasLazu.AspNet.Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>../../README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MasLazu.AspNet.Framework.EfCore\MasLazu.AspNet.Framework.EfCore.csproj" />
  </ItemGroup>

</Project>
