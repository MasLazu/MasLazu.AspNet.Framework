<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Properties -->
    <PackageId>MasLazu.AspNet.Framework.Endpoint</PackageId>
    <Version>1.0.0</Version>
    <Authors>MasLazu</Authors>
    <Company>MasLazu</Company>
    <Description>Presentation layer for MasLazu.AspNet.Framework - Contains FastEndpoints implementations, response models, and API endpoint patterns.</Description>
    <PackageTags>dotnet;aspnetcore;fastendpoints;api;endpoints;clean-architecture</PackageTags>
    <RepositoryUrl>https://github.com/MasLazu/MasLazu.AspNet.Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MasLazu.AspNet.Framework.Application\MasLazu.AspNet.Framework.Application.csproj" />
  </ItemGroup>

</Project>
