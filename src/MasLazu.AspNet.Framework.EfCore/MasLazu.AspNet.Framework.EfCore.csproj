<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Properties -->
    <PackageId>MasLazu.AspNet.Framework.EfCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>MasLazu</Authors>
    <Company>MasLazu</Company>
    <Description>EF Core infrastructure layer for MasLazu.AspNet.Framework - Contains repository implementations, database contexts, and data access patterns.</Description>
    <PackageTags>dotnet;aspnetcore;efcore;repository;orm;clean-architecture</PackageTags>
    <RepositoryUrl>https://github.com/MasLazu/MasLazu.AspNet.Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MasLazu.AspNet.Framework.Domain\MasLazu.AspNet.Framework.Domain.csproj" />
    <ProjectReference Include="..\MasLazu.AspNet.Framework.Application\MasLazu.AspNet.Framework.Application.csproj" />
  </ItemGroup>

</Project>
