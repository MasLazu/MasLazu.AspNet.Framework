<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Properties -->
    <PackageId>MasLazu.AspNet.Framework.Domain</PackageId>
    <Version>1.0.0</Version>
    <Authors>MasLazu</Authors>
    <Company>MasLazu</Company>
    <Description>Domain layer for MasLazu.AspNet.Framework - Contains core business entities and domain logic with soft delete support.</Description>
    <PackageTags>dotnet;aspnetcore;domain;entities;clean-architecture</PackageTags>
    <RepositoryUrl>https://github.com/MasLazu/MasLazu.AspNet.Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
